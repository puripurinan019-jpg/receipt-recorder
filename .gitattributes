# บังคับ line ending ให้คงที่ — กันปัญหา CRLF บน Windows ทำให้ CI บน macOS พัง
# (run: | ใน GitHub Actions ถ้ามี \r จะทำให้ bash ตกรายการ)
* text=auto

*.swift       text eol=lf
*.pbxproj     text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.py          text eol=lf
*.json        text eol=lf
*.xcstrings   text eol=lf
*.plist       text eol=lf
*.md          text eol=lf
*.xcassets    text eol=lf

# ไฟลีไบนารีห้ามแตะ
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.zip   binary
